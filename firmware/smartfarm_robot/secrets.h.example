// 이 파일을 복사해서 같은 폴더에 secrets.h 로 저장하고, 값을 채운다.
//   cp secrets.h.example secrets.h
// secrets.h는 .gitignore에 걸려있어 git에 안 올라간다. 진짜 값은 거기에만 넣는다.
// (이 .example 파일은 git에 올라가는 템플릿이라 실제 값을 적으면 안 된다.)

#pragma once

const char* WIFI_SSID = "your-wifi-name";
const char* WIFI_PASS = "your-wifi-password";

// Supabase 프로젝트 값 — Project Settings → API Keys 에서 확인.
const char* SUPABASE_URL      = "https://YOUR-PROJECT.supabase.co";
const char* SUPABASE_ANON_KEY = "sb_publishable_...";
